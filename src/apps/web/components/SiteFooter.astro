          </radialGradient>
        </defs>
        <circle cx="32" cy="33" r="28" fill="#F5AE10" stroke="#D68400" stroke-width="2"/>
        <circle cx="32" cy="33" r="23.5" fill="#FFFDF5"/>
        <circle cx="32" cy="33" r="19.8" fill="url(#yslice-foot)"/>
        <g stroke="#FFFDF5" stroke-width="2.8" stroke-linecap="round">
          <line x1="32" y1="12" x2="32" y2="54"/>
          <line x1="11" y1="33" x2="53" y2="33"/>
          <line x1="17.2" y1="18.2" x2="46.8" y2="47.8"/>
