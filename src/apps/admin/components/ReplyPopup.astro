<!-- Standing-Reply Auto-Popup on Non-Creator Submission (Changes 32 & 38) -->
<div class="modal-overlay" id="reply-popup" hidden>
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="reply-popup-title">
    <span class="modal-badge"><span class="t-ja">送信完了</span><span class="t-cn">已发送</span><span class="t-en">Sent</span></span>
    <h3 id="reply-popup-title"><span class="t-ja">運営者からのお返事</span><span class="t-cn">来自管理者的回复</span><span class="t-en">Reply from the Operator</span></h3>
    <div class="modal-reply-body" id="reply-popup-body"></div>
    <div class="row" style="justify-content:flex-end;margin:0">
      <button type="button" class="btn btn-primary mini" id="reply-popup-close"><span class="t-ja">閉じる</span><span class="t-cn">关闭</span><span class="t-en">Close</span></button>
    </div>
  </div>
</div>
