# ==============================================================================
# TSUBAME RECORD — Environment Variables Template
# ==============================================================================
# For local development with `wrangler pages dev`, copy this file to `.dev.vars`
# and fill in your own values. Never commit `.dev.vars` or real secrets.
# For production, configure these in Cloudflare Pages -> Settings -> Environment variables.

# --- Owner Console (/admin) Authentication (X OAuth 2.0) ---
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# Comma-separated numeric X user IDs allowed to sign in to /admin
OWNER_X_USER_IDS=
# Random 32+ byte secret used to sign owner session cookies
OWNER_SESSION_SECRET=
# Set to "1" only for local development bypass; leave empty or "0" in production
OWNER_TEST_MODE=0

# --- Rights-Holder Contact Form & Mail Relay (Optional) ---
# Comma-separated email addresses that receive contact/rights-holder notifications
OWNER_ALERT_EMAILS=
# Direct fallback email address for owner alerts (optional)
OWNER_DIRECT_EMAIL=
# Shared secret between Pages Functions and your Cloudflare Mail Relay worker
RELAY_SECRET=

# --- Cloudflare Pages Bindings (Configure in Dashboard / wrangler.toml) ---
# PORTAL_STATE : KV Namespace binding for runtime flags, drafts, and owner state
# MAIL_RELAY   : Optional Service Binding to an outbound mail relay worker
# EMAIL        : Optional Cloudflare Email Routing send binding
# ASSETS       : Automatically provided by Cloudflare Pages
